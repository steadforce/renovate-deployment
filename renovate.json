{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "customManagers:dockerfileVersions"
  ],
  "packageRules": [
    {
      "automerge": true,
      "automergeStrategy": "squash",
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["minor", "patch"]
    }
  ],
  "postUpdateOptions": [
    "helmUpdateSubChartArchives"
  ]
}
