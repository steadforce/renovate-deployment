{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "customManagers:dockerfileVersions"
  ],
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)values.*\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "renovate"
      ],
      "separateMultipleMajor": true
    },
    {
      "automerge": true,
      "automergeStrategy": "squash",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "automerge": true,
      "automergeStrategy": "squash",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "digest",
        "major",
        "minor",
        "patch"
      ],
      "platformAutomerge": true
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "addLabels": [
        "update:patch"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "addLabels": [
        "update:minor"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "update:major"
      ]
    },
    {
      "description": "Maintain the shared hydration labeller with native GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "steadforce/steadops-workflows"
      ],
      "matchFileNames": [
        ".github/workflows/label-renovate-hydration.yaml"
      ],
      "pinDigests": true
    }
  ]
}
